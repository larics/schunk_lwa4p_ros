<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lwa4p_wsg50">
    <xacro:arg name="gazebo" default="true"/>

    <!-- includes -->
    <xacro:include filename="$(find schunk_lwa4p_description)/urdf/lwa4p/lwa4p_arm.xacro" >
        <xacro:arg name="gazebo" value="${gazebo}"/>
    </xacro:include>

    <xacro:include filename="$(find schunk_lwa4p_description)/urdf/common.xacro"/>

    <xacro:include filename="$(find schunk_lwa4p_description)/urdf/tools/wsg50.urdf.xacro"/>

    <link name="world">
    </link>

    <joint name="world_base_joint" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
    </joint>

    <!-- foot for arm -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.5" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.1" length="1.0"/>
            </geometry>
            <material name="Gazebo/Black" />
        </visual>
        <collision>
            <origin xyz="0 0 0.5" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.1" length="1.0"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0.5" rpy="0 0 0"/>
            <mass value="10000.0"/>
            <inertia ixx="10000.0"  ixy="0"  ixz="0" iyy="10000.0" iyz="0" izz="10000.0" />
        </inertial>
    </link>

    <!-- arm -->
    <xacro:lwa4p_arm arm_id="lwa4p" parent="base_link" has_podest="true" >
        <origin xyz="0 0 1.05" rpy="0 0 0" />
    </xacro:lwa4p_arm>

    <!-- wsg 50 gripper -->
    <xacro:wsg_50_xacro name="wsg50" parent="lwa4p_link6" finger_length="0.1" finger_tip="0.08" off_dist="0.085" rotation="${pi/2}" >
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:wsg_50_xacro>

</robot>
