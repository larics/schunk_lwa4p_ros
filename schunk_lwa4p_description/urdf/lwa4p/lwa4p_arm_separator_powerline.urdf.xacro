<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lwa4p">
  <xacro:arg name="gazebo" default="true"/>
	
  <!-- includes -->
  <xacro:include filename="$(find schunk_lwa4p_description)/urdf/lwa4p/lwa4p_arm.xacro" >
  	<xacro:arg name="gazebo" value="${gazebo}"/>
  </xacro:include>
  <xacro:include filename="$(find schunk_lwa4p_description)/urdf/tools/separator.xacro">
	<xacro:arg name="gazebo" value="${gazebo}"/>
  </xacro:include>  
  <xacro:include filename="$(find schunk_lwa4p_description)/urdf/tools/separator_distancer.xacro">
	<xacro:arg name="gazebo" value="${gazebo}"/>
  </xacro:include>
  <xacro:include filename="$(find schunk_lwa4p_description)/urdf/powerline.xacro"/>


  
  <xacro:include filename="$(find schunk_lwa4p_description)/urdf/common.xacro"/>

  <link name="world">
  </link>

  <joint name="world_base_joint" type="fixed">
	<parent link="world"/>
	<child link="base_link"/>
  </joint>

  <!-- foot for arm -->
  <link name="base_link">
	<visual>
		<origin xyz="0 0 0.25" rpy="0 0 0" />
		<geometry>
			<cylinder radius="0.1" length="0.5"/>
		</geometry>
		<material name="Gazebo/Black" />
	</visual>
	<collision>
		<origin xyz="0 0 0.25" rpy="0 0 0" />
		<geometry>
			<cylinder radius="0.1" length="0.5"/>
		</geometry>
	</collision>
	<inertial>
		<origin xyz="0 0 0.25" rpy="0 0 0"/>
		<mass value="10000.0"/>
		<inertia ixx="10000.0"  ixy="0"  ixz="0" iyy="10000.0" iyz="0" izz="10000.0" />
	</inertial>
  </link>
 
  <!-- arm -->
  <xacro:lwa4p_arm arm_id="lwa4p" parent="base_link" has_podest="true" >
    <origin xyz="0 0 0.50" rpy="0 0 0" />
  </xacro:lwa4p_arm>

  <!-- tool -->
  <xacro:separator ns="lwa4p" rpy="0 0 ${pi/4}" connected_to="lwa4p_link6" safety_distance="0.03"/>

  <!-- separator distancer -->
  <xacro:separator_distancer ns="lwa4p" rpy="0 0 0" xyz="0 0 0.05"/>
  
  <!-- powerline --> 
  <xacro:powerline base_x="0" base_y="0" powerline_height="1.195" x_distance="0.185" y_distance="1.25" gazebo="true" two_cables="true" cable_distance="0.4"/>

</robot>
