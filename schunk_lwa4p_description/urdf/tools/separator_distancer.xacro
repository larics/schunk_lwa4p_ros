<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="separator_distancer"> 

    <xacro:macro name="separator_distancer" params="rpy:='0 0 0' ns:='' xyz:='0 0 0.01' ">

        <xacro:property name="scale_factor" value="3.937007"/>

        <xacro:arg name="gazebo" default="true"/>
            <xacro:if value="$(arg gazebo)">
            <!-- Gazebo Tags -->
            <xacro:include filename="$(find schunk_lwa4p_description)/urdf/tools/separator_distancer.gazebo.xacro"/>
        </xacro:if>

        <joint name="separator_distancer_joint" type="fixed" >
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <!--parent link="lwa4p_link6"/-->
            <parent link="separator_base"/>
            <child link="separator_main"/>
        </joint>

        <link name="separator_main">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <mass value="1" />
                <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://schunk_lwa4p_description/meshes/separator/separator3.STL" scale="0.0254 0.0254 0.0254"/>
                </geometry>
                <material name="white"/>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://schunk_lwa4p_description/meshes/separator/separator3.STL" scale="0.0254 0.0254 0.0254"/>
                </geometry>
            </collision>
        </link>


        <link name="separator_right_head">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <mass value="0.2" />
                <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 ${0.545/scale_factor} -0.01"/>
                <geometry>
                    <mesh filename="package://schunk_lwa4p_description/meshes/separator/separator1.STL" scale="0.0254 0.0254 0.0254"/>
                </geometry>
                <material name="custom"/>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 ${0.545/scale_factor} -0.01"/>
                <geometry>
                    <mesh filename="package://schunk_lwa4p_description/meshes/separator/separator1.STL" scale="0.0254 0.0254 0.0254"/>
                </geometry>
            </collision>
        </link>

        <joint name="separator_main_right_head_joint" type="revolute">
            <parent link="separator_main"/>
            <child link="separator_right_head"/>
            <origin xyz="0 -${0.54/scale_factor} 0" rpy="0 0 0"/>
            <limit effort="10" velocity="0.5" lower="-0.45" upper="0"/>
            <axis xyz="1 0 0"/>
        </joint>

        <link name="separator_left_head">
            <inertial>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <mass value="0.2" />
                <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1"/>
                <material name="white"/>
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 -${0.545/scale_factor} -0.01"/>
                <geometry>
                    <mesh filename="package://schunk_lwa4p_description/meshes/separator/separator2.STL" scale="0.0254 0.0254 0.0254"/>
                </geometry>
                <material name="custom"/>
            </visual>
            <collision>
                <origin rpy="0 0 0" xyz="0 -${0.545/scale_factor} -0.01"/>
                <geometry>
                    <mesh filename="package://schunk_lwa4p_description/meshes/separator/separator2.STL" scale="0.0254 0.0254 0.0254"/>
                </geometry>
            </collision>
        </link>

        <joint name="separator_main_left_head_joint" type="revolute">
            <parent link="separator_main"/>
            <child link="separator_left_head"/>
            <origin xyz="0 ${0.54/scale_factor} 0" rpy="0 0 0"/>
            <limit effort="10" velocity="0.5" lower="0" upper="0.45"/>
            <axis xyz="1 0 0"/>
        </joint>
    </xacro:macro>
</robot>