<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="hand">
  <!-- safety_distance: Minimum safety distance in [m] by which the collision volumes are expanded and which is enforced during robot motions -->
  <xacro:macro name="hand" params="connected_to:='' ns:='' rpy:='0 0 0' xyz:='0 0 0.0824' safety_distance:=0">
    <xacro:unless value="${connected_to == ''}">
      <joint name="${ns}_hand_joint" type="fixed">
        
        <parent link="${connected_to}"/>
        <child link="${ns}_hand"/>
        <origin xyz="${xyz}" rpy="${rpy}"/>
      </joint>
    </xacro:unless>
    
    <xacro:arg name="gazebo" default="true"/>
    <xacro:if value="$(arg gazebo)">
      <!-- Gazebo Tags -->
      <xacro:include filename="$(find schunk_lwa4p_moveit)/urdf/tools/hand.gazebo.xacro"/>
    </xacro:if>

    <link name="${ns}_hand">
      <xacro:default_inertial/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://schunk_lwa4p_moveit/meshes/gripper/base.stl" />
        </geometry>
        <material name="Schunk/DarkGrey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://schunk_lwa4p_moveit/meshes/gripper/base.stl" />
        </geometry>
      </collision>
    </link>
    
    <joint name="${ns}_finger_joint1" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${ns}_hand"/>
      <child link="${ns}_leftfinger"/>
      <axis xyz="0 1 0"/>
      <limit effort="20.1" velocity="1.26" lower="${-0.023}" upper="${0.0}" />
    </joint>
    
    <link name="${ns}_leftfinger">
      <xacro:default_inertial/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://schunk_lwa4p_moveit/meshes/gripper/left.stl" />
        </geometry>
        <material name="Schunk/DarkGrey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://schunk_lwa4p_moveit/meshes/gripper/left.stl" />
        </geometry>
      </collision>
    </link>
    
    <joint name="${ns}_finger_joint2" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${ns}_hand"/>
      <child link="${ns}_rightfinger"/>
      <axis xyz="0 -1 0"/>
      <mimic joint="${ns}_finger_joint1" multiplier="1" offset="0"/> 
      <limit effort="20.1" velocity="1.26" lower="${-0.023}" upper="${0.0}" />
    </joint>

    <link name="${ns}_rightfinger">
      <xacro:default_inertial/>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://schunk_lwa4p_moveit/meshes/gripper/right.stl" />
        </geometry>
        <material name="Schunk/DarkGrey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://schunk_lwa4p_moveit/meshes/gripper/right.stl" />
        </geometry>
      </collision>
    </link>

  </xacro:macro>
</robot>
