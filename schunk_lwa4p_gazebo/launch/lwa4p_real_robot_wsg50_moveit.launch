<?xml version="1.0"?>
<launch>
    <param name="/use_sim_time" value="false"/>

    <arg name="paused" default="false" doc="Started gazebo in paused mode" />
    <arg name="gui" default="true" doc="Starts gazebo gui" />
    <arg name="gripper" default="false" doc="Loads different model and different controllers with gripper on" />
    <arg name="real_robot" default="true"/>

    <!-- used in control arm node to call lwa4p driver initialization !-->
    <param name="real_robot" value="true"/>

    <!-- Send robot URDF to param server -->
    <!-- TODO: Add WSG-50 gripper -->
    <!-- There's no CAN communication set up with SocketCAN for that gripper -->
    <include file="$(find schunk_lwa4p_description)/launch/lwa4p_arm_wsg50_upload.launch"/>

    <!-- Start arm controller -->
    <!--rosparam file="$(find schunk_lwa4p_gazebo)/controller/arm_controller.yaml" command="load"/!-->
    <!--node name="arm_controller_spawner"  pkg="controller_manager" type="controller_manager" args="load arm_controller joint_state_controller" respawn="false" output="screen"/-->

    <!-- Launch driver and some controllers if real robot -->
    <include file="$(find schunk_lwa4p)/launch/schunk_bare_blue.launch" />

    <!-- Start MoveIt! -->
    <include file="$(find schunk_lwa4p_wsg50_config)/launch/demo_planning_execution.launch">
        <arg name="respawn_robot" value="true" />
        <!-- joint remapping is done in move_group.launch -->
    </include>

    <!-- Start Arm control node -->
    <include file="$(find schunk_lwa4p_control)/launch/arm_control.launch"></include>

</launch>