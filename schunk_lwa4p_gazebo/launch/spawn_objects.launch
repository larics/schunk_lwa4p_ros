<?xml version="1.0"?>

<launch>
  <include file="$(find schunk_lwa4p_gazebo)/launch/spawn_table.launch">
    <arg name="x" value="0.0"/>
    <arg name="y" value="0.75"/>
    <arg name="z" value="0.0"/>
  </include>

  <include file="$(find schunk_lwa4p_gazebo)/launch/spawn_brick.launch">
    <arg name="x" value="-0.4"/>
    <arg name="y" value="0.3"/>
    <arg name="z" value="1.0"/>
  </include>

  <include file="$(find schunk_lwa4p_gazebo)/launch/spawn_bottle.launch">
    <arg name="x" value="0.25"/>
    <arg name="y" value="0.45"/>
    <arg name="z" value="1.00"/>
  </include>

</launch>
