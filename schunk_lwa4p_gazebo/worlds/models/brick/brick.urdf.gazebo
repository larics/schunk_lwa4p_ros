<robot name="Brick" xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="Brick">
    <visual>
    <geometry>
      <mesh filename="$(find or_worlds)/models/brick/brick.stl" scale="1 1 1" />
    </geometry>
    <material name="OR_cyan">
      <color rgba="0.2 0.0 0.7 1.0"/>
    </material>
    </visual>
    <inertial>
      <inertia ixx="10" ixy="0.0" ixz="0.0" iyy="10" iyz="0.0"
        izz="10" />
    <mass value="1.0" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="$(find or_worlds)/models/brick/brick.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>

  <gazebo>
    <static>false</static>
  </gazebo>

</robot>
